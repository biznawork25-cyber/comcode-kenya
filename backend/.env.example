APP_ENV=development
BILLING_LIVE_ENABLED=false
BILLING_ACCOUNT_LINKING_ENABLED=false
DATABASE_URL=postgresql+psycopg://comcode:change-me@localhost:5432/comcode
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Use Paystack test keys for development. Configure matching KES plans in Paystack.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEEKLY_PLAN_CODE=
PAYSTACK_MONTHLY_PLAN_CODE=
PAYSTACK_YEARLY_PLAN_CODE=
PAYSTACK_CALLBACK_URL=http://localhost:3000/checkout/complete

# Use Safaricom Daraja sandbox credentials first.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Set a long random token and configure a scheduler to call the renewal endpoint.
RENEWAL_JOB_TOKEN=
